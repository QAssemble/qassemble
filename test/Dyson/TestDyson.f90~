program TestBareG
  use DiagEDyson
  implicit none
  

  integer :: iomega,iorb,jorb,ik
  double precision :: pi  
  complex*16 :: omega(0:9), g0(2,2,1,2,0:9), g(2,2,1,2,0:9), sig(2,2,1,2,0:9), gref(2,2,1,2,0:9)


  pi=datan2(1.0d0,1.0d0)*4.0d0
  do iomega=0, 9
    omega(iomega)=dcmplx(0.0d0, (2*iomega+1))
  enddo


  do iorb=1, 2
    do ik=1, 2
      do iomega=0, 9
        g0(iorb,iorb,1,ik,iomega)=1.0d0/(omega(iomega)-1.0d0)
        sig(iorb,iorb,1,ik,iomega)=10*ik+iorb
        gref(iorb,iorb,1,ik,iomega)=1.0d0/(omega(iomega)-1.0d0-sig(iorb,iorb,1,ik,iomega))
      enddo
    enddo
  enddo
  
  call DysonLatticeFermion(2,1,2,10,g0,sig,g)

  
  do iorb=1, 2
    do jorb=1, 2
      do ik=1, 2
        do iomega=0, 9
          if (cdabs(g(iorb,jorb,1,ik,iomega)-gref(iorb,jorb,1,ik,iomega)) .gt. 1.0d-6) then
            print '(4i5, 4f12.6)', iorb, jorb, ik, iomega, g0(iorb,jorb,1,ik,iomega), gref(iorb,jorb,1,ik,iomega)
          endif
        enddo
      enddo
    enddo
  enddo

  
end program TestBareG
    


  
