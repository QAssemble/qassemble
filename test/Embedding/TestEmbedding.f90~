program TestEmbedding
  use Embedding
  implicit none


  integer :: iorb1,iorb2,is,ik,iomega, is1,is2
  complex*16 :: tempmat1(3,2), err, &
    gloc(2,2,2,0:2), glattref(3,3,2,5,0:2), gproj(3,2,2,5), &
    glocstc(3,3,2), glatstc(3,3,2,5), glocdyn(3,3,2,0:2),glatdyn(3,3,2,5,0:2), &
    hlatt(3,3,2,5), hloc(2,2,2), hlattref(3,3,2,5), hproj(3,2,2,5), &
    wlatt(3,3,2,2,5,0:2), wloc(2,2,2,2,0:2), wlattref(3,3,2,2,5,0:2), wproj(3,2,2,5), &
    vlatt(3,3,2,2,5), vloc(2,2,2,2), vlattref(3,3,2,2,5), vproj(3,2,2,5)    

! glatt(3,3,2,5,0:2), gloc(2,2,2,0:2), glocref(2,2,2,0:2), gproj(3,2,2,5),     

  glatt=0.0d0
  gloc=0.0d0
  glattref=0.0d0
  gproj=0.0d0

  do iomega=0, 2
    do is=1, 2
      do iorb1=1, 3
        do iorb2=1, 3
          gloc(iorb1,iorb2,is,iomega)=iorb1+0.1d0*iomega+iorb2*2+dcmplx(0.0d0,(is)*0.1d0)
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is=1, 2
      do iorb1=1, 3
        do iorb2=1, 2
          gproj(iorb1,iorb2,is,ik)=0.1d0*is+ik*0.5d0+(iorb1-iorb2)*2.0d0
        enddo
      enddo
    enddo
  enddo


  do iomega=0, 2
    do ik=1, 5      
      do is=1, 2
        tempmat1=matmul(gproj(:,:,is,ik), gloc(:,:,is,iomega))
        glattref(:,:,is,ik,iomega)=matmul(tempmat1, transpose(dconjg(gproj(:,:,is,ik))))
      enddo
    enddo
  enddo

  call LocFStc(3,2,gloc(:,:,:,0),2,gproj(:,:,:,1),glocstc)
  call LatFStc(3,2,5,gloc(:,:,:,0),2,gproj,glatstc)
  call LocFDyn(3,2,3,gloc,2,gproj(:,:,:,1),glocdyn)
  call LatFDyn(3,2,5,3,gloc,2,gproj,glatdyn)

  do is=1, 2
    do iorb1=1, 3
      do iorb2=1, 3      
        err=glatref(iorb1,iorb2,is,1,0)-glocstc(iorb1,iorb2,is)
        if (cdabs(err) .gt. 1.0d-6) then
          print '(3i5, 5(2x, f12.6))', iorb1, iorb2, is, cdabs(err), glattref(iorb1,iorb2,is,1,0), glocstc(iorb1,iorb2,is)
        endif
      enddo
    enddo
  enddo

  do iomega=0,2
    do is=1, 2
      do iorb1=1, 3
        do iorb2=1, 3      
          err=glatref(iorb1,iorb2,is,1,iomega)-glocdyn(iorb1,iorb2,is,iomega)
          if (cdabs(err) .gt. 1.0d-6) then
            print '(4i5, 5(2x, f12.6))', iorb1, iorb2, is, iomega,cdabs(err), glattref(iorb1,iorb2,is,1,iomega), glocdyn(iorb1,iorb2,is,iomega)
          endif
        enddo
      enddo
    enddo
  enddo


  do ik=1,5
    do is=1, 2
      do iorb1=1, 3
        do iorb2=1, 3      
          err=glatref(iorb1,iorb2,is,ik,0)-glatstc(iorb1,iorb2,is,ik)
          if (cdabs(err) .gt. 1.0d-6) then
            print '(4i5, 5(2x, f12.6))', iorb1, iorb2, is, ik,cdabs(err), glattref(iorb1,iorb2,is,ik,0), glatstc(iorb1,iorb2,is,ik)
          endif
        enddo
      enddo
    enddo
  enddo


  do iomega=0,2
    do ik=1,5
      do is=1, 2
        do iorb1=1, 3
          do iorb2=1, 3      
            err=glatref(iorb1,iorb2,is,ik,iomega)-glatdyn(iorb1,iorb2,is,ik,iomega)
            if (cdabs(err) .gt. 1.0d-6) then
              print '(5i5, 5(2x, f12.6))', iorb1, iorb2, is, ik,iomega,cdabs(err), glattref(iorb1,iorb2,is,ik,iomega), glatstc(iorb1,iorb2,is,ik,iomega)
            endif
          enddo
        enddo
      enddo
    enddo
  enddo



  wlatt=0.0d0
  wloc=0.0d0
  wlattref=0.0d0
  wproj=0.0d0

  do iomega=0, 2
    do is1=1, 2
      do is2=1, 2      
        do iorb1=1, 3
          do iorb2=1, 3
            wloc(iorb1,iorb2,is1,is2,iomega)=iorb1+0.1d0*iomega+iorb2*2+dcmplx(0.0d0,(is1-is2)*0.1d0)
          enddo
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is1=1, 2
      do iorb1=1, 3
        do iorb2=1, 2
          wproj(iorb1,iorb2,is1,ik)=0.1d0*is1+ik*0.5d0+(iorb1-iorb2)*2.0d0
        enddo
      enddo
    enddo
  enddo


  do iomega=0, 2
    do ik=1, 5      
      do is1=1, 2
        do is2=1, 2        
          tempmat1=matmul(wproj(:,:,is1,ik), wloc(:,:,is1,is2,iomega))
          wlattref(:,:,is1,is2,ik,iomega)=matmul(tempmat1, transpose(dconjg(wproj(:,:,is2,ik))))
        enddo
      enddo
    enddo
  enddo
!!! from here
  call LocBStc(3,2,5,3,wloc,2,wproj,wlatt)
  call LocBDyn(3,2,5,3,wloc,2,wproj,wlatt)
  call LatBStc(3,2,5,3,wloc,2,wproj,wlatt)
  call LatBDyn(3,2,5,3,wloc,2,wproj,wlatt)  

  do iomega=0, 2
    do ik=1, 5
      do is1=1, 2
        do is2=1, 2        
          do iorb1=1, 2
            do iorb2=1, 2      
              err=wlatt(iorb1,iorb2,is1,is2,ik,iomega)-wlattref(iorb1,iorb2,is1,is2,ik,iomega)
              if (cdabs(err) .gt. 1.0d-6) then
                print '(6i5, 5(2x, f12.6))', iorb1, iorb2, is1,is2,ik,iomega, cdabs(err), wlatt(iorb1,iorb2,is1,is2,ik,iomega), wlattref(iorb1,iorb2,is1,is2,ik,iomega)
              endif
            enddo
          enddo
        enddo
      enddo
    enddo
  enddo

  print *, ''
  print *, ''
  print *, ''


  vlatt=0.0d0
  vloc=0.0d0
  vlattref=0.0d0
  vproj=0.0d0

  do is1=1, 2
    do is2=1, 2      
      do iorb1=1, 3
        do iorb2=1, 3
          vloc(iorb1,iorb2,is1,is2)=iorb1+iorb2*2+dcmplx(0.0d0,(is1-is2)*0.1d0)
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is1=1, 2
      do iorb1=1, 3
        do iorb2=1, 2
          vproj(iorb1,iorb2,is1,ik)=0.1d0*is1+ik*0.5d0+(iorb1-iorb2)*2.0d0
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is1=1, 2
      do is2=1, 2        
        tempmat1=matmul(vproj(:,:,is1,ik), vloc(:,:,is1,is2))
        vlattref(:,:,is1,is2,ik)=matmul(tempmat1, transpose(dconjg(vproj(:,:,is2,ik))))
      enddo
    enddo
  enddo

  call EmbeddingBosonStatic(3,2,5,vloc,2,vproj,vlatt)


  do ik=1, 2
    do is1=1, 2
      do is2=1, 2        
        do iorb1=1, 2
          do iorb2=1, 2      
            err=vlatt(iorb1,iorb2,is1,is2,ik)-vlattref(iorb1,iorb2,is1,is2,ik)
            if (cdabs(err) .gt. 1.0d-6) then
              print '(5i5, 5(2x, f12.6))', iorb1, iorb2, is1,is2,ik,cdabs(err), vlatt(iorb1,iorb2,is1,is2,ik), vlattref(iorb1,iorb2,is1,is2,ik)
            endif
          enddo
        enddo
      enddo
    enddo
  enddo

  print *, ''
  print *, ''
  print *, ''




end program TestEmbedding

