program TestProjection
  use DiagEProjection
  implicit none


  integer :: iorb1,iorb2,is,ik,iomega, is1,is2
  complex*16 :: tempmat1(3,2), err, &
    glatt(3,3,2,5,0:2), gloc(2,2,2,0:2), glocref(2,2,2,0:2), gproj(3,2,2,5), &
    hlatt(3,3,2,5), hloc(2,2,2), hlocref(2,2,2), hproj(3,2,2,5), &
    wlatt(3,3,2,2,5,0:2), wloc(2,2,2,2,0:2), wlocref(2,2,2,2,0:2), wproj(3,2,2,5), &
    vlatt(3,3,2,2,5), vloc(2,2,2,2), vlocref(2,2,2,2), vproj(3,2,2,5)    

! glatt(3,3,2,5,0:2), gloc(2,2,2,0:2), glocref(2,2,2,0:2), gproj(3,2,2,5),     

  glatt=0.0d0
  gloc=0.0d0
  glocref=0.0d0
  gproj=0.0d0

  do iomega=0, 2
    do ik=1, 5
      do is=1, 2
        do iorb1=1, 3
          do iorb2=1, 3
            glatt(iorb1,iorb2,is,ik,iomega)=10*ik+iorb1+0.1d0*iomega+iorb2*2+dcmplx(0.0d0,(is)*0.1d0)
          enddo
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is=1, 2
      do iorb1=1, 3
        do iorb2=1, 2
          gproj(iorb1,iorb2,is,ik)=0.1d0*is+ik*0.5d0+(iorb1-iorb2)*2.0d0
        enddo
      enddo
    enddo
  enddo


  do iomega=0, 2
    do ik=1, 5      
      do is=1, 2
        tempmat1=matmul(glatt(:,:,is,ik,iomega), gproj(:,:,is,ik))
        glocref(:,:,is,iomega)=glocref(:,:,is,iomega)+matmul(transpose(dconjg(gproj(:,:,is,ik))), tempmat1)/5
      enddo
    enddo
  enddo

  call ProjectionFermionDynamic(3,2,5,3,glatt,2,gproj,gloc)


  do iomega=0, 2
    do is=1, 2
      do iorb1=1, 2
        do iorb2=1, 2      
          err=gloc(iorb1,iorb2,is,iomega)-glocref(iorb1,iorb2,is,iomega)
          if (cdabs(err) .gt. 1.0d-6) then
            print '(4i5, 5(2x, f12.6))', iorb1, iorb2, is,iomega, cdabs(err), gloc(iorb1,iorb2,is,iomega), glocref(iorb1,iorb2,is,iomega)
          endif
        enddo
      enddo
    enddo
  enddo


  print *, ''
  print *, ''
  print *, ''   


  hlatt=0.0d0
  hloc=0.0d0
  hlocref=0.0d0
  hproj=0.0d0

  do ik=1, 5
    do is=1, 2
      do iorb1=1, 3
        do iorb2=1, 3
          hlatt(iorb1,iorb2,is,ik)=10*ik+iorb1+iorb2*2+dcmplx(0.0d0,(is)*0.1d0)
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is=1, 2
      do iorb1=1, 3
        do iorb2=1, 2
          hproj(iorb1,iorb2,is,ik)=0.1d0*is+ik*0.5d0+(iorb1-iorb2)*2.0d0
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is=1, 2
      tempmat1=matmul(hlatt(:,:,is,ik), hproj(:,:,is,ik))
      hlocref(:,:,is)=hlocref(:,:,is)+matmul(transpose(dconjg(hproj(:,:,is,ik))), tempmat1)/5
    enddo
  enddo

  call ProjectionFermionStatic(3,2,5,hlatt,2,hproj,hloc)

  do is=1, 2
    do iorb1=1, 2
      do iorb2=1, 2      
        err=hloc(iorb1,iorb2,is)-hlocref(iorb1,iorb2,is)
        if (cdabs(err) .gt. 1.0d-6) then
          print '(3i5, 5(2x,f12.6))', iorb1, iorb2, is,cdabs(err), hloc(iorb1,iorb2,is), hlocref(iorb1,iorb2,is)
        endif
      enddo
    enddo
  enddo

  print *, ''
  print *, ''
  print *, ''   



  wlatt=0.0d0
  wloc=0.0d0
  wlocref=0.0d0
  wproj=0.0d0

  do iomega=0, 2
    do ik=1, 5
      do is1=1, 2
        do is2=1, 2        
          do iorb1=1, 3
            do iorb2=1, 3
              wlatt(iorb1,iorb2,is1,is2,ik,iomega)=10*ik+iorb1+0.1d0*iomega+iorb2*2+dcmplx(0.0d0,(is1-is2)*0.1d0)
            enddo
          enddo
        enddo
      enddo
    enddo
  end do


  do ik=1, 5      
    do is1=1, 2
      do iorb1=1, 3
        do iorb2=1, 2
          wproj(iorb1,iorb2,is1,ik)=0.1d0*is1+ik*0.5d0+(iorb1-iorb2)*2.0d0
        enddo
      enddo
    enddo
  enddo


  do iomega=0, 2
    do ik=1, 5
      do is1=1, 2
        do is2=1, 2        
          tempmat1=matmul(wlatt(:,:,is1,is2,ik,iomega), wproj(:,:,is2,ik))
          wlocref(:,:,is1,is2,iomega)=wlocref(:,:,is1,is2,iomega)+matmul(transpose(dconjg(wproj(:,:,is1,ik))), tempmat1)/5
        enddo
      enddo
    enddo
  enddo

  call ProjectionBosonDynamic(3,2,5,3,wlatt,2,wproj,wloc)


  do iomega=0, 2
    do is1=1, 2
      do is2=1, 2      
        do iorb1=1, 2
          do iorb2=1, 2      
            err=wloc(iorb1,iorb2,is1,is2,iomega)-wlocref(iorb1,iorb2,is1,is2,iomega)
            if (cdabs(err) .gt. 1.0d-6) then
              print '(5i5, 5(2x, f12.6))', iorb1, iorb2, is1,is2,iomega, cdabs(err), wloc(iorb1,iorb2,is1,is2,iomega), wlocref(iorb1,iorb2,is1,is2,iomega)
            endif
          enddo
        enddo
      enddo
    enddo
  enddo


  print *, ''
  print *, ''
  print *, ''




  vlatt=0.0d0
  vloc=0.0d0
  vlocref=0.0d0
  vproj=0.0d0

  do ik=1, 5
    do is1=1, 2
      do is2=1, 2        
        do iorb1=1, 3
          do iorb2=1, 3
            vlatt(iorb1,iorb2,is1,is2,ik)=10*ik+iorb1+iorb2*2+dcmplx(0.0d0,(is1-is2)*0.1d0)
          enddo
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5      
    do is1=1, 2
      do iorb1=1, 3
        do iorb2=1, 2
          vproj(iorb1,iorb2,is1,ik)=0.1d0*is1+ik*0.5d0+(iorb1-iorb2)*2.0d0
        enddo
      enddo
    enddo
  enddo


  do ik=1, 5
    do is1=1, 2
      do is2=1, 2        
        tempmat1=matmul(vlatt(:,:,is1,is2,ik), vproj(:,:,is2,ik))
        vlocref(:,:,is1,is2)=vlocref(:,:,is1,is2)+matmul(transpose(dconjg(vproj(:,:,is1,ik))), tempmat1)/5
      enddo
    enddo
  enddo

  call ProjectionBosonStatic(3,2,5,vlatt,2,vproj,vloc)


  do is1=1, 2
    do is2=1, 2      
      do iorb1=1, 2
        do iorb2=1, 2      
          err=vloc(iorb1,iorb2,is1,is2)-vlocref(iorb1,iorb2,is1,is2)
          if (cdabs(err) .gt. 1.0d-6) then
            print '(4i5, 5(2x, f12.6))', iorb1, iorb2, is1,is2, cdabs(err), vloc(iorb1,iorb2,is1,is2), vlocref(iorb1,iorb2,is1,is2)
          endif
        enddo
      enddo
    enddo
  enddo


  print *, ''
  print *, ''
  print *, ''     


end program TestProjection

