include ../../arch.mk

.SUFFIXES: .f90 .o

TARGET = TestProjection

OBJ = \
  TestProjection.o

OBJCommon = \
  ../../modules/DiagEProjection.o \
  ../../modules/DiagECommon.o \
  ../Common/Common.o

all: $(OBJ)   
	$(FC)  $(FFLAG) $(INCLUDE) $(LOADLIBES) $(OBJ) $(OBJCommon) -I../../modules -o $(TARGET)
.f90.o: 
	$(FC) -c $(FFLAG) $(INCLUDE) $(LOADLIBES) -I../../modules $<

new:
	make clean
	make all 
clean:
	rm -rf *.so
	rm -rf *.o
	rm -rf *.mod
	rm -rf $(TARGET)


