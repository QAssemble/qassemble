include ../../arch.mk

.SUFFIXES: .f90 .o

TARGET = TestBare

OBJ = \
  TestBare.o

OBJCommon = \
  ../../modules/DiagEBare.o \
  ../../modules/DiagECommon.o \
  ../Common/Common.o

all: $(OBJ)
	$(FC) $(FFLAG) $(INCLUDE) $(LOADLIBES) $(OBJ) $(OBJCommon) -I../../modules -o $(TARGET)
new:
	make clean
	make all
.f90.o:
	$(FC) -c $(FFLAG) $(INCLUDE) $(LOADLIBES) -I../../modules $<
clean:
	rm -rf *.so
	rm -rf *.o
	rm -rf *.mod
	rm -rf $(TARGET)


