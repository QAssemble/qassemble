include ../../barch.mk

.SUFFIXES: .f90 .o

TARGET = TestFourierKR  

OBJ = \
  TestFourierKR.o

OBJCommon = \
  ../../modules/Common.o \
  ../../modules/Fourier.o \

all: $(OBJ)
	$(FC) $(FFLAGS) $(MKL) $(FFTW) $(LIBES) $(INCLUDE) -L$(LOADLIBES) $(OBJ) $(OBJCommon) -I../../modules -o $(TARGET)
new:
	make clean
	make all
.f90.o:
	$(FC) -c $(FFLAGS) $(INCLUDE) -L$(LOADLIBES) -I../../modules $<
clean:
	rm -rf *.so
	rm -rf *.o
	rm -rf *.mod
	rm -rf $(TARGET)


