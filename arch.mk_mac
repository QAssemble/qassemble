FC = gfortran
INCLUDE = -I${QAssemble}/finufft/include -I/opt/homebrew/opt/fftw/include -I/opt/homebrew/opt/lapack/include
#FFLAGS = -debug -g -CB -check bounds -traceback -check uninit -fp-model precise
FFLAGS = -DMPI -lblas -llapack -lpthread -lm -lfftw3 -llapack
LDFLAGS = # -L
LOADLIBES = ${DIAGE}/finufft/lib/libfinufft.so #-lfftw3 -llapack
#LOADLIBES = ../finufft/lib/libfinufft.so -lfftw3 -mkl
LIBES = /opt/homebrew/opt/lapack/lib#-llapack -lpthread -lm
FFTW = -I/opt/homebrew/opt/fftw/include
MKL = -I/opt/homebrew/opt/lapack/include
#LIBES = -L/home/momichael98/temp/Fortran/DiagE/modules/fftw3/fftw-3.3.10/lib -lfftw3 -mkl
#FFTW = -I/home/momichael98/temp/Fortran/DiagE/modules/fftw3/fftw-3.3.10/include
fortran2python = /Users/moseongjun/.pyenv/versions/3.9.16/bin/f2py -c --fcompiler=gfortran --compiler=unix  $(LOADLIBES) $(LIBES)/liblapack.dylib $(INCLUDE)



